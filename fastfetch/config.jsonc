{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/active.txt",
        "color": {
          "1": "white"
        }
  },
  "display": {
    "color": "34"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
        "type": "display",
        "format": "{width}x{height}"
    },
    "wm",
    "cursor",
    "terminal",
    {
        "type": "terminalfont",
        "format": "{name} {size}"
    },
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    {
        "type": "colors",
        "paddingLeft": 6,
        "symbol": "block"
    }
  ]
}
