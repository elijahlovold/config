#!/bin/sh
# Toggle between the dual-monitor layout (DP-2 primary + DP-1 portrait secondary)
# and the solo third monitor (HDMI-A-1). Wayland/Hyprland rewrite of the old
# X11/xrandr version.
#
# This Hyprland config uses the Lua config provider, so `hyprctl keyword` is
# rejected ("keyword can't work with non-legacy parsers") -- persistent config
# changes (i.e. monitor enable/disable) go through `hyprctl eval '<lua>'`
# calling hl.monitor() instead. hl.monitor() merges onto the existing rule for
# that output, so `disabled` must be passed explicitly on every call --
# omitting it leaves whatever was set before (e.g. monitors.lua's static
# disabled=true) untouched.
#
# Disabling a monitor does NOT reliably migrate its workspaces elsewhere --
# per https://github.com/hyprwm/Hyprland/issues/5052 this is a known,
# deliberately-unfixed gap ("closed as not planned"), not something specific
# to the Lua config. Left alone, a workspace can end up assigned to a monitor
# that no longer exists: its windows keep running, but nothing can display or
# refocus them. So every workspace on a source monitor is moved to the target
# explicitly, while the source is still enabled, before disabling it -- via
# plain `hyprctl dispatch moveworkspacetomonitor`, a runtime action rather
# than a config `keyword`, so it isn't affected by the Lua-provider
# restriction above and needs no `eval`.
#
# Keep PRIMARY/SECONDARY/SOLO in sync with hyprland/monitors.lua.

[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || exit 0

PRIMARY="DP-2"
SECONDARY="DP-1"
SOLO="HDMI-A-1"

is_active() {
    hyprctl monitors -j | jq -e --arg name "$1" 'any(.[]; .name == $name)' > /dev/null
}

# Moves every ordinary (non-special) workspace on $1 to $2. Special/scratchpad
# workspaces (negative ids, e.g. the "magic" one bound in keybinds.lua) are
# left alone.
move_workspaces() {
    src="$1"
    dst="$2"
    hyprctl workspaces -j | jq -r --arg name "$src" '.[] | select(.monitor == $name and .id > 0) | .id' |
        while read -r id; do
            hyprctl dispatch moveworkspacetomonitor "$id $dst"
        done
}

to_dual() {
    hyprctl eval "
        hl.monitor({ output = '$PRIMARY', mode = '3840x2160@60', position = 'auto', scale = 'auto', disabled = false })
        hl.monitor({ output = '$SECONDARY', mode = '1920x1080@60', position = '0x0', scale = 1, transform = 3, disabled = false })
    "
    move_workspaces "$SOLO" "$PRIMARY"
    hyprctl eval "hl.monitor({ output = '$SOLO', disabled = true })"
    wallpaper-picker > /dev/null 2>&1 &
}

to_solo() {
    hyprctl eval "
        hl.monitor({ output = '$SOLO', mode = '1920x1080@60', position = 'auto', scale = 'auto', disabled = false })
    "
    move_workspaces "$PRIMARY" "$SOLO"
    move_workspaces "$SECONDARY" "$SOLO"
    hyprctl eval "
        hl.monitor({ output = '$PRIMARY', disabled = true })
        hl.monitor({ output = '$SECONDARY', disabled = true })
    "
    pkill mpvpaper
}

if [ "$1" = "--reset" ]; then
    to_dual
    exit 0
fi

if is_active "$SOLO"; then
    to_dual
else
    to_solo
fi
