#!/bin/python

import os
import sys
from datetime import date

bday = date(2003, 8, 19)

today = date.fromisoformat(sys.argv[1]) if len(sys.argv) > 1 else date.today()

vault_path = f"{os.path.expanduser('~')}/vault"
cal_path = f"{vault_path}/Calendar"
out_path = f"{cal_path}/{today.year}"
template_file = f"{vault_path}/Templates/Daily-Template.md"

outfile = f"{out_path}/{today.isoformat()}.md"

if not os.path.isfile(outfile):
    years = today.year - bday.year
    if (today.month, today.day) < (bday.month, bday.day):
        years -= 1
    bible_plan_path = f"{cal_path}/bible_plan_{years}.csv"

    start_year = today.year
    if (today.month, today.day) < (bday.month, bday.day):
        start_year -= 1
    start_date = bday.replace(year=start_year)
    today_entry = (today - start_date).days

    with open(bible_plan_path, "r") as f:
        bible_plan_lines = f.readlines()
        weeks = int(today_entry / 7)
        dow = today_entry % 7
        entry_i = 9 * weeks + 1 + dow
        today_passage = bible_plan_lines[entry_i]

        passages = []
        def split_ref(ref: str) -> tuple[str, str | None]:
            import re
            match = re.fullmatch(
                r"\s*((?:[1-3]\s+)?[A-Za-z]+(?:\s+[A-Za-z]+)*?)"
                r"(?:\s+(\d+(?:-\d+)?))?\s*",
                ref,
            )

            if not match:
                raise ValueError(f"Invalid passage reference: {ref!r}")

            book, chapters = match.groups()
            return book, chapters


        for entry in map(str.strip, today_passage.split(",")):
            book, chapters = split_ref(entry)

            if chapters:
                passages.append(f"{book} {chapters}")
            else:
                passages.append(book)

    with open(template_file, "r") as fin, open(outfile, "w") as fout:
        for i, line in enumerate(fin):
            if line.startswith("created:"):
                fout.write(f"created: {today.isoformat()}\n")
                continue
            fout.write(line)
            if line.startswith("passages:"):
                for p in passages:
                    fout.write(f" - {p}\n")

print(outfile)
